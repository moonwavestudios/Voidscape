[sub_resource type="GDScript" id="GDScript_86q0k"]
script/source = "extends Button

@export var target_node: NodePath

var ui_hid = false

func _on_pressed() -> void:
	if not ui_hid:
		_slide()
	else:
		slide_out()

func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"hide_top\"):
		if not ui_hid:
			_slide()
		else:
			slide_out()

func _slide() -> void:
	var tween = create_tween()
	tween.tween_property(get_node(target_node), \"position\", Vector2(656.0, -87.0), 0.5)
	tween.set_ease(Tween.EASE_IN)
	$\".\".text = \"Expand (M)\"
	ui_hid = true

func slide_out() -> void:
	var tween = create_tween()
	tween.tween_property(get_node(target_node), \"position\", Vector2(656.0, 0.0), 0.5)
	tween.set_ease(Tween.EASE_IN)
	$\".\".text = \"Collapse (M)\"
	ui_hid = false
"

