[sub_resource type="GDScript" id="GDScript_n58qp"]
script/source = "extends Area3D

var hit = 0

func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		if hit == 3:
			if body.has_shield:
				body.has_shield = false
			else:
				body.dead = true
			
		hit += 1
		body.velocity.y = 10
		$\"../AudioStreamPlayer3D\".play()
"

