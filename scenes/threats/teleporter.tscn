[sub_resource type="GDScript" id="GDScript_o1y51"]
script/source = "extends Area3D

func _on_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		if not body.has_shield:
			body.dead = true
		else:
			body.has_shield = false
"

